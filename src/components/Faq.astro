---
import { faq } from '../data';
---

<section class="section section--alt" id="fragen">
  <div class="container">
    <div class="section-header">
      <h2>Häufige Fragen zum Anhängerverleih</h2>
    </div>
    <div class="faq">
      {faq.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 840px;
  }

  details {
    border-bottom: 1px solid var(--color-line);
  }

  details:first-of-type {
    border-top: 1px solid var(--color-line);
  }

  summary {
    position: relative;
    padding: 18px 44px 18px 0;
    font-weight: 700;
    font-size: 1.06rem;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    position: absolute;
    top: 50%;
    right: 8px;
    color: var(--color-brand);
    font-size: 1.5rem;
    font-weight: 400;
    transform: translateY(-50%);
  }

  details[open] summary::after {
    content: '–';
  }

  p {
    max-width: 44em;
    padding: 0 20px 18px 0;
    color: var(--color-muted);
  }
</style>
