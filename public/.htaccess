# taubertal-anhaenger.de (Apache). Other servers ignore this file.
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Always https and www, so the site has exactly one address.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.taubertal-anhaenger.de%{REQUEST_URI} [L,R=301]
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

<IfModule mod_mime.c>
AddType text/markdown .md
AddType image/webp .webp
AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
# script-src/style-src come from the <meta> CSP that Astro generates with hashes (security.csp).
# frame-ancestors only works as a header, so it is set here.
Header always set Content-Security-Policy "frame-ancestors 'none'"

# Files in /_astro/ have a content hash in their name and never change.
<If "%{REQUEST_URI} =~ m#^/_astro/#">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
# Fixed file names (og-bild.jpg, favicon, font): long enough to help, short enough to replace.
ExpiresByType image/jpeg "access plus 1 week"
ExpiresByType image/png "access plus 1 week"
ExpiresByType image/svg+xml "access plus 1 week"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/markdown text/xml application/xml image/svg+xml
</IfModule>
